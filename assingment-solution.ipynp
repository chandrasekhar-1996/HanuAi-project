def perform_exploratory_data_analysis(df):
    """Generates statistical summaries, checks nulls/duplicates, and plots key column distributions."""
    print("\n--- TASK 2.1: EXPLORATORY DATA ANALYSIS ---")
    print(f"Dataset Shape: {df.shape}")
    print("\nData Types and Missing Values:")
    print(df.info())
    print("\nMissing Values Count:\n", df.isnull().sum())
    print(f"\nDuplicate Rows Count: {df.duplicated().sum()}")
    
    # Statistical summary for numerical fields
    print("\nStatistical Summary (Numerical Columns):")
    print(df.describe())
    
    # Plot Ratings Distribution
    plt.figure(figsize=(12, 5))
    
    plt.subplot(1, 2, 1)
    sns.countplot(data=df, x='Rating', palette='viridis')
    plt.title('Distribution of Customer Ratings (1-5 Stars)')
    plt.xlabel('Rating')
    plt.ylabel('Count')
    
    # Plot Review Length Distribution
    df['Review_Length'] = df['Review_Text'].apply(lambda x: len(str(x).split()))
    plt.subplot(1, 2, 2)
    sns.histplot(df['Review_Length'], kde=True, color='skyblue', bins=20)
    plt.title('Distribution of Review Word Lengths')
    plt.xlabel('Word Count')
    plt.ylabel('Frequency')
    
    plt.tight_layout()
    plt.show()


def extract_entities_and_mine_tags(text):
    """
    Extracts structured NLP tags (Components, Issues, Severity, Qualifiers)
    from unstructured review text using spaCy NER and dependency parsing.
    """
    doc = nlp(str(text))
    extracted_entities = {
        "Components": [],
        "Issue_Keywords": [],
        "Adjectives": []
    }
    
    issue_lexicon = ['rotate', 'bulky', 'assemble', 'noisy', 'broken', 'heat', 'battery', 'charge', 'crack', 'fit', 'slow', 'fail']
    
    for token in doc:
        # Extract Nouns as potential product components
        if token.pos_ in ['NOUN', 'PROPN'] and not token.is_stop:
            extracted_entities["Components"].append(token.text.lower())
        # Extract Adjectives describing product attributes
        elif token.pos_ == 'ADJ' and not token.is_stop:
            extracted_entities["Adjectives"].append(token.text.lower())
        # Extract specific issue indicators
        if token.lemma_.lower() in issue_lexicon:
            extracted_entities["Issue_Keywords"].append(token.lemma_.lower())
            
    # Remove duplicates
    extracted_entities["Components"] = list(set(extracted_entities["Components"]))[:4]
    extracted_entities["Issue_Keywords"] = list(set(extracted_entities["Issue_Keywords"]))
    extracted_entities["Adjectives"] = list(set(extracted_entities["Adjectives"]))[:4]
    
    return extracted_entities


def categorize_issue_type(extracted_tags, review_text):
    """Rule-based issue taxonomy mapping extracted NLP entities to standardized issue types."""
    text_lower = review_text.lower()
    
    if any(w in text_lower for w in ['rotate', 'bulky', 'fit', 'size', 'heavy', 'button', 'assemble', 'installation']):
        return "Design & Usability Issue"
    elif any(w in text_lower for w in ['power', 'battery', 'charge', 'wire', 'turn on', 'screen', 'fuse']):
        return "Electrical & Battery Issue"
    elif any(w in text_lower for w in ['break', 'crack', 'broken', 'plastic', 'snap', 'fall apart', 'wear']):
        return "Mechanical & Structural Component Failure"
    elif any(w in text_lower for w in ['slow', 'software', 'app', 'connect', 'bluetooth', 'wifi', 'freeze']):
        return "Connectivity & Software Issue"
    else:
        return "General Quality / Performance Issue"


def apply_topic_modeling_and_clustering(df, n_topics=3, n_clusters=3):
    """Applies TF-IDF Vectorization, LDA Topic Modeling, and K-Means Clustering."""
    print("\n--- TASK 2.3: TOPIC MODELING & K-MEANS CLUSTERING ---")
    
    # Preprocessing text for vectorization
    stop_words = list(stopwords.words('english')) + ['item', 'product', 'bought', 'got', 'get', 'one', 'use', 'would']
    vectorizer = TfidfVectorizer(max_features=500, stop_words=stop_words, ngram_range=(1, 2))
    tfidf_matrix = vectorizer.fit_transform(df['Review_Text'])
    
    # 1. Latent Dirichlet Allocation (LDA) Topic Modeling
    lda = LatentDirichletAllocation(n_components=n_topics, random_state=42)
    lda_topics = lda.fit_transform(tfidf_matrix)
    df['Dominant_Topic_ID'] = lda_topics.argmax(axis=1)
    
    feature_names = vectorizer.get_feature_names_out()
    print("\nExtracted LDA Topics (Top Key Terms):")
    for topic_idx, topic in enumerate(lda.components_):
        top_features = [feature_names[i] for i in topic.argsort()[:-6:-1]]
        print(f"  Topic #{topic_idx + 1}: {', '.join(top_features)}")
        
    # 2. K-Means Clustering
    kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
    df['Cluster_ID'] = kmeans.fit_predict(tfidf_matrix)
    print(f"\nSuccessfully clustered reviews into {n_clusters} clusters.")
    
    return df, vectorizer, lda, kmeans


