            {"Primary_Key": "R109823LLSKQ09", "Title": "Poor mechanical latch", "Review_Text": "The chest clip broke after two weeks of light use. Very hard to adjust straps when cold.", "Date": "2024-02-01", "Rating": 1.0, "Source": "www.bestbuy.ca", "Reviewer_Name": "Alex P."},
